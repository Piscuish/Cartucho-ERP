{
  "name": "cartucho-license-server",
  "private": true,
  "version": "0.1.0",
  "description": "Servidor de licencias de Cartucho ERP (Cloudflare Workers + D1).",
  "type": "module",
  "scripts": {
    "keys": "node scripts/generate-keys.mjs",
    "db:local": "wrangler d1 migrations apply cartucho-licencias --local",
    "db:remote": "wrangler d1 migrations apply cartucho-licencias --remote",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
