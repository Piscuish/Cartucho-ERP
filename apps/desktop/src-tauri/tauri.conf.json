{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartucho ERP",
  "version": "0.4.0",
  "identifier": "com.cartucho.erp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartucho ERP",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "decorations": false,
        "shadow": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cartucho ERP",
    "category": "Business",
    "shortDescription": "Facturación y gestión para pequeñas empresas",
    "longDescription": "Cartucho ERP: facturas, cotizaciones, catálogo, inventario, clientes y finanzas. Funciona sin Internet; los datos quedan en el equipo.",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Cartucho ERP"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQjczOTlDMzY5OURGNjMKUldSajM1azJuRG0zQTY5ZFhJM2ljMWgzK1h2RzNIUUpnYnJyMzZjZW9DSzhVbVRkZm5qeE8wSXMK",
      "endpoints": [
        "https://github.com/Piscuish/Cartucho-ERP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
